name: Build Android APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-22.04

    steps:
    - name: Descargar repositorio
      uses: actions/checkout@v3

    - name: Configurar Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'

    - name: Instalar herramientas de compilacion
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential ccache git libffi-dev libssl-dev python3-dev openjdk-17-jdk unzip zip libsqlite3-dev zlib1g-dev libncurses5-dev libgdbm-dev libnss3-dev libreadline-dev libbz2-dev liblzma-dev scons
        pip install --upgrade pip
        pip install buildozer cython==0.29.33

    - name: Compilar APK
      run: |
        yes | buildozer -v android debug

    - name: Guardar archivo APK
      uses: actions/upload-artifact@v4
      with:
        name: Viyuva-APK
        path: bin/*.apk
        
